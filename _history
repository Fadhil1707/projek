\n"]]},{"start1":7994,"length1":0,"diffs":[[1,"\r\n    driveMotors(\r\n        baseSpeed,\r\n        baseSpeed\r\n    )\r\n\r\n    robotState = \"FORWARD\"\r\n"]]},{"start1":8095,"length1":128,"diffs":[[1,"// =====================================================\r\n// SCAN: SEARCH FOR LINE\r\n// =====================================================\r\n"]]},{"start1":8239,"length1":0,"diffs":[[1,"// Ketika garis hilang, robot berputar ke arah terakhir\r\n// garis terdeteksi. Robot tidak perlu mundur atau U-turn.\r\n\r\n"]]},{"start1":8384,"length1":27,"diffs":[[1,"    robotState = \"SCAN\"\r\n"]]},{"start1":8411,"length1":0,"diffs":[[1,"    basic.showIcon(IconNames.Search)\r\n\r\n"]]},{"start1":8476,"length1":177,"diffs":[[1,"        driveMotors(\r\n            0,\r\n            searchSpeed\r\n        )\r\n"]]},{"start1":8564,"length1":100,"diffs":[[1,"        driveMotors(\r\n            searchSpeed,\r\n            0\r\n        )\r\n"]]},{"start1":8645,"length1":0,"diffs":[[1,"\r\n    // Baca kembali sensor setelah koreksi singkat.\r\n    basic.pause(15)\r\n\r\n    readLineSensors()\r\n\r\n    if (leftSensor == 0 || rightSensor == 0) {\r\n        robotState = \"FORWARD\"\r\n    }\r\n"]]},{"start1":8840,"length1":95,"diffs":[[1,"// =====================================================\r\n// FINISH MARKER\r\n// =====================================================\r\n\r\n// Pada Maqueen Lite standar, hanya ada dua sensor IR.\r\n// Finish dideteksi jika kedua sensor membaca hitam\r\n// secara bersamaan selama waktu yang ditentukan.\r\n"]]},{"start1":9140,"length1":154,"diffs":[[1,"// Setelah berhenti sebentar dan berbunyi, robot\r\n// melanjutkan AUTO. Marker tidak langsung dipicu ulang\r\n// sebelum kedua sensor kembali membaca putih.\r\n"]]},{"start1":9297,"length1":0,"diffs":[[1,"function checkFinishMarker() {\r\n    if (!finishArmed) {\r\n        if (leftSensor == 1 && rightSensor == 1) {\r\n            finishArmed = true\r\n        }\r\n\r\n        return\r\n    }\r\n\r\n    if (leftSensor == 0 && rightSensor == 0) {\r\n        if (finishStartTime == 0) {\r\n            finishStartTime = control.millis()\r\n        }\r\n\r\n        if (\r\n            control.millis() - finishStartTime\r\n            >= finishDelay\r\n        ) {\r\n            finishArmed = false\r\n            finishStartTime = 0\r\n\r\n            stopMotors()\r\n\r\n            robotState = \"FINISH\"\r\n\r\n            basic.showIcon(IconNames.Happy)\r\n            finishBeep()\r\n\r\n            basic.pause(500)\r\n\r\n            // Setelah berhenti sebentar,\r\n            // lanjutkan close loop AUTO.\r\n            if (\r\n                currentMode == \"AUTO\" &&\r\n                !emergencyStop\r\n            ) {\r\n                robotState = \"AUTO\"\r\n            }\r\n        }\r\n    } else {\r\n        finishStartTime = 0\r\n    }\r\n}\r\n\r\n// =====================================================\r\n// MANUAL CONTROL VIA ACCELEROMETER\r\n// =====================================================\r\n\r\n// Miring ke depan  = maju\r\n// Miring ke belakang = mundur\r\n// Miring ke kiri = belok kiri\r\n// Miring ke kanan = belok kanan\r\n// Posisi mendatar = berhenti\r\n\r\n"]]},{"start1":10618,"length1":0,"diffs":[[1,"    if (manualScan) {\r\n        scanForLine()\r\n        return\r\n    }\r\n\r\n"]]},{"start1":10785,"length1":43,"diffs":[[1,"    let threshold = 20\r\n"]]},{"start1":10811,"length1":120,"diffs":[[1,"    if (pitch < -threshold) {\r\n        driveMotors(\r\n            baseSpeed,\r\n            baseSpeed\r\n        )\r\n"]]},{"start1":10924,"length1":120,"diffs":[[1,"        robotState = \"FORWARD\"\r\n    } else if (pitch > threshold) {\r\n        driveMotors(\r\n            -baseSpeed,\r\n            -baseSpeed\r\n        )\r\n"]]},{"start1":11077,"length1":81,"diffs":[[1,"        robotState = \"BACKWARD\"\r\n    } else if (roll < -threshold) {\r\n        driveMotors(\r\n            baseSpeed - turnSpeed,\r\n            baseSpeed\r\n        )\r\n"]]},{"start1":11241,"length1":296,"diffs":[[1,"        lastTurn = -1\r\n        robotState = \"LEFT\"\r\n    } else if (roll > threshold) {\r\n        driveMotors(\r\n            baseSpeed,\r\n            baseSpeed - turnSpeed\r\n        )\r\n"]]},{"start1":11423,"length1":40,"diffs":[[1,"        lastTurn = 1\r\n        robotState = \"RIGHT\"\r\n    } else {\r\n        stopMotors()\r\n        robotState = \"MANUAL\"\r\n    }\r\n"]]},{"start1":11554,"length1":145,"diffs":[[1,"// =====================================================\r\n// BUTTON A: AUTO / MANUAL\r\n// =====================================================\r\n"]]},{"start1":11700,"length1":193,"diffs":[[1,"input.onButtonPressed(\r\n    Button.A,\r\n    function () {\r\n        if (emergencyStop) {\r\n            emergencyStop = false\r\n            obstacleActive = false\r\n            obstacleBeeped = false\r\n\r\n            setMode(\"MANUAL\")\r\n            stopMotors()\r\n            basic.showString(\"M\")\r\n            return\r\n        }\r\n\r\n        if (currentMode == \"AUTO\") {\r\n            setMode(\"MANUAL\")\r\n            stopMotors()\r\n        } else {\r\n            setMode(\"AUTO\")\r\n        }\r\n"]]},{"start1":12182,"length1":4,"diffs":[[1,")\r\n"]]},{"start1":12187,"length1":190,"diffs":[[1,"// =====================================================\r\n// BUTTON B: BUZZER TEST / SCAN\r\n// =====================================================\r\n"]]},{"start1":12338,"length1":142,"diffs":[[1,"// Tekan B saat MANUAL untuk mengetes buzzer.\r\n// Tekan B saat AUTO untuk memulai SCAN manual.\r\n"]]},{"start1":12436,"length1":104,"diffs":[[1,"input.onButtonPressed(\r\n    Button.B,\r\n    function () {\r\n        if (emergencyStop) {\r\n            return\r\n"]]},{"start1":12555,"length1":0,"diffs":[[1,"\r\n        if (currentMode == \"MANUAL\") {\r\n            buzzerTest()\r\n        } else if (currentMode == \"AUTO\") {\r\n            manualScan = true\r\n            robotState = \"SCAN\"\r\n        }\r\n"]]},{"start1":12750,"length1":4,"diffs":[[1,")\r\n"]]},{"start1":12755,"length1":199,"diffs":[[1,"// =====================================================\r\n// BUTTON A+B: EMERGENCY STOP\r\n// =====================================================\r\n"]]},{"start1":12904,"length1":151,"diffs":[[1,"input.onButtonPressed(\r\n    Button.AB,\r\n    function () {\r\n        emergencyStop = true\r\n        currentMode = \"STOP\"\r\n        robotState = \"STOP\"\r\n"]]},{"start1":13054,"length1":153,"diffs":[[1,"        stopMotors()\r\n\r\n        obstacleActive = false\r\n        manualScan = false\r\n\r\n        emergencyBeep()\r\n\r\n        basic.showIcon(IconNames.No)\r\n"]]},{"start1":13212,"length1":4,"diffs":[[1,")\r\n"]]},{"start1":13217,"length1":55,"diffs":[[1,"// =====================================================\r\n"]]},{"start1":13287,"length1":55,"diffs":[[1,"// =====================================================\r\n"]]},{"start1":13347,"length1":24,"diffs":[[1,"stopMotors()\r\nledsOn()\r\n\r\nbasic.showString(\"MB\")\r\n\r\n"]]},{"start1":13417,"length1":12,"diffs":[[1,""]]},{"start1":13419,"length1":55,"diffs":[[1,"setMode(\"AUTO\")\r\n\r\n// =====================================================\r\n"]]},{"start1":13510,"length1":55,"diffs":[[1,"// =====================================================\r\n"]]},{"start1":13570,"length1":428,"diffs":[[1,"basic.forever(\r\n    function () {\r\n        // Emergency STOP mengunci pergerakan.\r\n        if (emergencyStop) {\r\n            stopMotors()\r\n            basic.pause(50)\r\n            return\r\n        }\r\n\r\n        // Baca jarak dan periksa obstacle.\r\n        readDistance()\r\n\r\n        if (handleObstacle()) {\r\n            basic.pause(50)\r\n            return\r\n        }\r\n\r\n        obstacleActive = false\r\n\r\n        // AUTO atau MANUAL.\r\n        if (currentMode == \"AUTO\") {\r\n            if (manualScan) {\r\n                scanForLine()\r\n\r\n                readLineSensors()\r\n\r\n                if (\r\n                    leftSensor == 0 ||\r\n                    rightSensor == 0\r\n                ) {\r\n                    manualScan = false\r\n                    robotState = \"AUTO\"\r\n                }\r\n            } else {\r\n                autoLineFollowing()\r\n            }\r\n        } else if (currentMode == \"MANUAL\") {\r\n            manualControl()\r\n        } else {\r\n            stopMotors()\r\n        }\r\n\r\n        basic.pause(15)\r\n"]]},{"start1":14600,"length1":4,"diffs":[[1,")\r\n"]]}]}]},{"timestamp":1793284963025,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>"]]}]}]},{"timestamp":1793362868036,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":286,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1791718181390,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1791720003082,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"\r\n/*\r\n * MAQUEEN V5 - MICRO:BIT\r\n * Firmware tanpa Bluetooth, USB Serial, dan GUI.\r\n *\r\n * Fitur:\r\n * AUTO / MANUAL / STOP\r\n * Line following 3 sensor IR\r\n * Ultrasonic obstacle detection\r\n * SCAN ketika garis hilang\r\n * RGB, buzzer, FINISH\r\n *\r\n * Ekstensi: Maqueen V5\r\n */\r\n\r\n// =====================================\r\n// KONFIGURASI\r\n// =====================================\r\n\r\nlet modeAuto = true\r\nlet manualScan = false\r\nlet baseSpeed = 100\r\nlet turnSpeed = 80\r\nlet obstacleLimit = 15\r\n\r\nlet finishLocked = false\r\nlet robotState = \"STOP\"\r\nlet lastDistance = 100\r\n\r\n// =====================================\r\n// MOTOR\r\n// =====================================\r\n\r\nfunction stopRobot(): void {\r\n    Maqueen_V5.motorStop(Maqueen_V5.Motors.All)\r\n    robotState = \"STOP\"\r\n}\r\n\r\nfunction moveForward(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    robotState = \"FORWARD\"\r\n}\r\n\r\nfunction moveBackward(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    robotState = \"BACKWARD\"\r\n}\r\n\r\nfunction moveLeft(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    robotState = \"LEFT\"\r\n}\r\n\r\nfunction moveRight(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    robotState = \"RIGHT\"\r\n}\r\n\r\n// =====================================\r\n// INDIKATOR RGB\r\n// =====================================\r\n\r\nfunction setRGB(color: Maqueen_V5.CarLightColors): void {\r\n    Maqueen_V5.setRgblLed(\r\n        Maqueen_V5.DirectionType.All,\r\n        color\r\n    )\r\n}\r\n\r\nfunction indicateAuto(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Green)\r\n    basic.showString(\"A\")\r\n}\r\n\r\nfunction indicateManual(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Blue)\r\n    basic.showString(\"M\")\r\n}\r\n\r\nfunction indicateStop(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Red)\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\nfunction indicateScan(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Purple)\r\n    basic.showIcon(IconNames.Search)\r\n}\r\n\r\nfunction indicateObstacle(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Red)\r\n    basic.showIcon(IconNames.Sad)\r\n}\r\n\r\nfunction indicateFinish(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Green)\r\n    basic.showIcon(IconNames.Heart)\r\n}\r\n\r\nfunction soundBeep(): void {\r\n    music.playTone(880, 100)\r\n}\r\n\r\n// =====================================\r\n// SENSOR IR V5\r\n// =====================================\r\n\r\n// Nilai 1 menandakan sensor aktif menurut\r\n// hasil digital pembacaan ekstensi V5.\r\n\r\nfunction readLeft(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.L)\r\n}\r\n\r\nfunction readMiddle(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.M)\r\n}\r\n\r\nfunction readRight(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.R)\r\n}\r\n\r\n// =====================================\r\n// SENSOR ULTRASONIK V5\r\n// =====================================\r\n\r\nfunction readDistance(): number {\r\n    return Maqueen_V5.Ultrasonic()\r\n}\r\n\r\n// =====================================\r\n// MODE AUTO / MANUAL\r\n// =====================================\r\n\r\nfunction activateAuto(): void {\r\n    modeAuto = true\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateAuto()\r\n}\r\n\r\nfunction activateManual(): void {\r\n    modeAuto = false\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateManual()\r\n}\r\n\r\n// =====================================\r\n// FINISH: KETIGA SENSOR AKTIF\r\n// =====================================\r\n\r\nfunction checkFinish(): boolean {\r\n    let left = readLeft()\r\n    let middle = readMiddle()\r\n    let right = readRight()\r\n\r\n    if (left == 1 && middle == 1 && right == 1) {\r\n        if (!finishLocked) {\r\n            finishLocked = true\r\n            stopRobot()\r\n            robotState = \"FINISH\"\r\n            indicateFinish()\r\n            soundBeep()\r\n            basic.pause(700)\r\n        }\r\n        return true\r\n    }\r\n\r\n    finishLocked = false\r\n    return false\r\n}\r\n\r\n// =====================================\r\n// OBSTACLE AVOIDANCE\r\n// =====================================\r\n\r\nfunction obstacleCheck(): boolean {\r\n    lastDistance = readDistance()\r\n\r\n    // Ultrasonik V5 dapat mengembalikan\r\n    // nilai besar saat tidak ada pantulan.\r\n    if (\r\n        lastDistance > 0 &&\r\n        lastDistance <= obstacleLimit\r\n    ) {\r\n        stopRobot()\r\n        robotState = \"OBSTACLE\"\r\n        indicateObstacle()\r\n        soundBeep()\r\n\r\n        // Berhenti sampai jalur di depan aman.\r\n        while (modeAuto) {\r\n            basic.pause(150)\r\n            lastDistance = readDistance()\r\n\r\n            if (lastDistance > obstacleLimit) {\r\n                break\r\n            }\r\n        }\r\n\r\n        stopRobot()\r\n        return true\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// =====================================\r\n// SCAN SAAT GARIS HILANG\r\n// =====================================\r\n\r\nfunction scanForLine(): void {\r\n    stopRobot()\r\n    robotState = \"SCAN\"\r\n    indicateScan()\r\n\r\n    let found = false\r\n\r\n    for (let i = 0; i < 8; i++) {\r\n        if (!modeAuto) {\r\n            stopRobot()\r\n            return\r\n        }\r\n\r\n        moveLeft(turnSpeed)\r\n        basic.pause(100)\r\n        stopRobot()\r\n        basic.pause(50)\r\n\r\n        if (\r\n            readLeft() == 1 ||\r\n            readMiddle() == 1 ||\r\n            readRight() == 1\r\n        ) {\r\n            found = true\r\n            break\r\n        }\r\n    }\r\n\r\n    if (!found) {\r\n        stopRobot()\r\n    }\r\n}\r\n\r\n// =====================================\r\n// LINE FOLLOWING OTOMATIS\r\n// =====================================\r\n\r\nfunction followLine(): void {\r\n    let left = readLeft()\r\n    let middle = readMiddle()\r\n    let right = readRight()\r\n\r\n    // Prioritas pertama: kondisi FINISH.\r\n    if (checkFinish()) {\r\n        return\r\n    }\r\n\r\n    // Prioritas kedua: rintangan.\r\n    if (obstacleCheck()) {\r\n        return\r\n    }\r\n\r\n    // Sensor tengah membaca garis.\r\n    if (left == 0 && middle == 1 && right == 0) {\r\n        moveForward(baseSpeed)\r\n    }\r\n    // Garis terdeteksi di kiri.\r\n    else if (left == 1 && right == 0) {\r\n        moveLeft(turnSpeed)\r\n    }\r\n    // Garis terdeteksi di kanan.\r\n    else if (right == 1 && left == 0) {\r\n        moveRight(turnSpeed)\r\n    }\r\n    // Ketiga sensor aktif ditangani FINISH.\r\n    else if (left == 1 && middle == 1 && right == 1) {\r\n        stopRobot()\r\n    }\r\n    // Tidak ada sensor membaca garis.\r\n    else if (left == 0 && middle == 0 && right == 0) {\r\n        scanForLine()\r\n    }\r\n    else {\r\n        moveForward(baseSpeed)\r\n    }\r\n}\r\n\r\n// =====================================\r\n// TOMBOL MICRO:BIT\r\n// =====================================\r\n\r\n// A: beralih AUTO / MANUAL\r\ninput.onButtonPressed(Button.A, function () {\r\n    if (modeAuto) {\r\n        activateManual()\r\n    } else {\r\n        activateAuto()\r\n    }\r\n})\r\n\r\n// B: SCAN saat MANUAL\r\ninput.onButtonPressed(Button.B, function () {\r\n    if (!modeAuto) {\r\n        manualScan = !manualScan\r\n\r\n        if (manualScan) {\r\n            stopRobot()\r\n            indicateScan()\r\n        } else {\r\n            stopRobot()\r\n            indicateManual()\r\n        }\r\n    }\r\n})\r\n\r\n// A+B: STOP\r\ninput.onButtonPressed(Button.AB, function () {\r\n    modeAuto = false\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateStop()\r\n    soundBeep()\r\n})\r\n\r\n// =====================================\r\n// KONTROL GERAK MANUAL DENGAN GESTUR\r\n// =====================================\r\n\r\ninput.onGesture(Gesture.LogoUp, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveForward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.LogoDown, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveBackward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltLeft, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveLeft(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltRight, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveRight(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.ScreenUp, function () {\r\n    if (!modeAuto) {\r\n        stopRobot()\r\n        indicateStop()\r\n    }\r\n})\r\n\r\n// =====================================\r\n// INISIALISASI\r\n// =====================================\r\n\r\nstopRobot()\r\nactivateAuto()\r\n\r\n// =====================================\r\n// PROGRAM UTAMA\r\n// =====================================\r\n\r\nbasic.forever(function () {\r\n    if (modeAuto) {\r\n        followLine()\r\n        basic.pause(20)\r\n    } else {\r\n        if (manualScan) {\r\n            stopRobot()\r\n            basic.pause(50)\r\n        } else {\r\n            basic.pause(20)\r\n        }\r\n    }\r\n})\r\n","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1791898395472,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"\r\n/*\r\n * MAQUEEN V5 - MICRO:BIT\r\n * Tanpa Bluetooth, USB Serial, dan GUI Python.\r\n *\r\n * AUTO / MANUAL / STOP\r\n * 3 sensor IR, ultrasonic, obstacle avoidance\r\n * SCAN, RGB, buzzer, FINISH\r\n */\r\n\r\n// ==============================\r\n// KONFIGURASI\r\n// ==============================\r\n\r\nlet modeAuto = true\r\nlet manualScan = false\r\nlet baseSpeed = 100\r\nlet turnSpeed = 80\r\nlet obstacleLimit = 15\r\n\r\nlet finishLocked = false\r\nlet robotState = \"STOP\"\r\nlet lastDistance = 100\r\n\r\n// ==============================\r\n// MOTOR\r\n// ==============================\r\n\r\nfunction stopRobot(): void {\r\n    Maqueen_V5.motorStop(Maqueen_V5.Motors.All)\r\n    robotState = \"STOP\"\r\n}\r\n\r\nfunction moveForward(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    robotState = \"FORWARD\"\r\n}\r\n\r\nfunction moveBackward(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    robotState = \"BACKWARD\"\r\n}\r\n\r\nfunction moveLeft(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    robotState = \"LEFT\"\r\n}\r\n\r\nfunction moveRight(speed: number): void {\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M1,\r\n        Maqueen_V5.Dir.CW,\r\n        speed\r\n    )\r\n    Maqueen_V5.motorRun(\r\n        Maqueen_V5.Motors.M2,\r\n        Maqueen_V5.Dir.CCW,\r\n        speed\r\n    )\r\n    robotState = \"RIGHT\"\r\n}\r\n\r\n// ==============================\r\n// RGB DAN INDIKATOR\r\n// ==============================\r\n\r\nfunction setRGB(color: Maqueen_V5.CarLightColors): void {\r\n    Maqueen_V5.setRgblLed(\r\n        Maqueen_V5.DirectionType.All,\r\n        color\r\n    )\r\n}\r\n\r\nfunction indicateAuto(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Green)\r\n    basic.showString(\"A\")\r\n}\r\n\r\nfunction indicateManual(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Blue)\r\n    basic.showString(\"M\")\r\n}\r\n\r\nfunction indicateStop(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Red)\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\nfunction indicateScan(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Purple)\r\n\r\n    // Pola SCAN khusus, tanpa IconNames.Search.\r\n    basic.showLeds(`\r\n        . . # . .\r\n        . # # # .\r\n        # . # . #\r\n        . . # . .\r\n        . # . # .\r\n    `)\r\n}\r\n\r\nfunction indicateObstacle(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Red)\r\n    basic.showIcon(IconNames.Sad)\r\n}\r\n\r\nfunction indicateFinish(): void {\r\n    setRGB(Maqueen_V5.CarLightColors.Green)\r\n    basic.showIcon(IconNames.Heart)\r\n}\r\n\r\nfunction soundBeep(): void {\r\n    music.playTone(880, 100)\r\n}\r\n\r\n// ==============================\r\n// SENSOR IR MAQUEEN V5\r\n// ==============================\r\n\r\nfunction readLeft(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.L)\r\n}\r\n\r\nfunction readMiddle(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.M)\r\n}\r\n\r\nfunction readRight(): number {\r\n    return Maqueen_V5.readPatrol(Maqueen_V5.Patrol.R)\r\n}\r\n\r\n// ==============================\r\n// ULTRASONIK\r\n// ==============================\r\n\r\nfunction readDistance(): number {\r\n    return Maqueen_V5.Ultrasonic()\r\n}\r\n\r\n// ==============================\r\n// MODE\r\n// ==============================\r\n\r\nfunction activateAuto(): void {\r\n    modeAuto = true\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateAuto()\r\n}\r\n\r\nfunction activateManual(): void {\r\n    modeAuto = false\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateManual()\r\n}\r\n\r\n// ==============================\r\n// FINISH\r\n// ==============================\r\n\r\nfunction checkFinish(): boolean {\r\n    let left = readLeft()\r\n    let middle = readMiddle()\r\n    let right = readRight()\r\n\r\n    if (left == 1 && middle == 1 && right == 1) {\r\n        if (!finishLocked) {\r\n            finishLocked = true\r\n            stopRobot()\r\n            robotState = \"FINISH\"\r\n            indicateFinish()\r\n            soundBeep()\r\n            basic.pause(700)\r\n        }\r\n\r\n        return true\r\n    }\r\n\r\n    finishLocked = false\r\n    return false\r\n}\r\n\r\n// ==============================\r\n// OBSTACLE AVOIDANCE\r\n// ==============================\r\n\r\nfunction obstacleCheck(): boolean {\r\n    lastDistance = readDistance()\r\n\r\n    if (\r\n        lastDistance > 0 &&\r\n        lastDistance <= obstacleLimit\r\n    ) {\r\n        stopRobot()\r\n        robotState = \"OBSTACLE\"\r\n        indicateObstacle()\r\n        soundBeep()\r\n\r\n        while (modeAuto) {\r\n            basic.pause(150)\r\n            lastDistance = readDistance()\r\n\r\n            if (lastDistance > obstacleLimit) {\r\n                break\r\n            }\r\n        }\r\n\r\n        stopRobot()\r\n        return true\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// ==============================\r\n// SCAN GARIS\r\n// ==============================\r\n\r\nfunction scanForLine(): void {\r\n    stopRobot()\r\n    robotState = \"SCAN\"\r\n    indicateScan()\r\n\r\n    let found = false\r\n\r\n    for (let i = 0; i < 8; i++) {\r\n        if (!modeAuto) {\r\n            stopRobot()\r\n            return\r\n        }\r\n\r\n        moveLeft(turnSpeed)\r\n        basic.pause(100)\r\n        stopRobot()\r\n        basic.pause(50)\r\n\r\n        if (\r\n            readLeft() == 1 ||\r\n            readMiddle() == 1 ||\r\n            readRight() == 1\r\n        ) {\r\n            found = true\r\n            break\r\n        }\r\n    }\r\n\r\n    if (!found) {\r\n        stopRobot()\r\n    }\r\n}\r\n\r\n// ==============================\r\n// AUTO LINE FOLLOWING\r\n// ==============================\r\n\r\nfunction followLine(): void {\r\n    let left = readLeft()\r\n    let middle = readMiddle()\r\n    let right = readRight()\r\n\r\n    if (checkFinish()) {\r\n        return\r\n    }\r\n\r\n    if (obstacleCheck()) {\r\n        return\r\n    }\r\n\r\n    if (left == 0 && middle == 1 && right == 0) {\r\n        moveForward(baseSpeed)\r\n    } else if (left == 1 && right == 0) {\r\n        moveLeft(turnSpeed)\r\n    } else if (right == 1 && left == 0) {\r\n        moveRight(turnSpeed)\r\n    } else if (left == 0 && middle == 0 && right == 0) {\r\n        scanForLine()\r\n    } else {\r\n        moveForward(baseSpeed)\r\n    }\r\n}\r\n\r\n// ==============================\r\n// TOMBOL A: AUTO / MANUAL\r\n// ==============================\r\n\r\ninput.onButtonPressed(Button.A, function () {\r\n    if (modeAuto) {\r\n        activateManual()\r\n    } else {\r\n        activateAuto()\r\n    }\r\n})\r\n\r\n// ==============================\r\n// TOMBOL B: SCAN MANUAL\r\n// ==============================\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n    if (!modeAuto) {\r\n        manualScan = !manualScan\r\n\r\n        if (manualScan) {\r\n            stopRobot()\r\n            indicateScan()\r\n        } else {\r\n            stopRobot()\r\n            indicateManual()\r\n        }\r\n    }\r\n})\r\n\r\n// ==============================\r\n// A+B: STOP\r\n// ==============================\r\n\r\ninput.onButtonPressed(Button.AB, function () {\r\n    modeAuto = false\r\n    manualScan = false\r\n    stopRobot()\r\n    indicateStop()\r\n    soundBeep()\r\n})\r\n\r\n// ==============================\r\n// KONTROL MANUAL GESTUR\r\n// ==============================\r\n\r\ninput.onGesture(Gesture.LogoUp, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveForward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.LogoDown, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveBackward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltLeft, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveLeft(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltRight, function () {\r\n    if (!modeAuto && !manualScan) {\r\n        moveRight(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.ScreenUp, function () {\r\n    if (!modeAuto) {\r\n        stopRobot()\r\n        indicateStop()\r\n    }\r\n})\r\n\r\n// ==============================\r\n// INISIALISASI\r\n// ==============================\r\n\r\nstopRobot()\r\nactivateAuto()\r\n\r\n// ==============================\r\n// PROGRAM UTAMA\r\n// ==============================\r\n\r\nbasic.forever(function () {\r\n    if (modeAuto) {\r\n        followLine()\r\n        basic.pause(20)\r\n    } else {\r\n        if (manualScan) {\r\n            stopRobot()\r\n        }\r\n\r\n        basic.pause(20)\r\n    }\r\n})\r\n","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1791988207260,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"\r\n/*\r\n * MAQUEEN LITE STANDARD + MICRO:BIT\r\n * MAKECODE JAVASCRIPT / TYPESCRIPT\r\n *\r\n * FITUR:\r\n * 1. AUTO LINE FOLLOWING (2 SENSOR IR)\r\n * 2. MANUAL DENGAN GESTUR MICRO:BIT\r\n * 3. AUTO / MANUAL\r\n * 4. EMERGENCY STOP (A+B)\r\n * 5. SCAN MANUAL\r\n * 6. ULTRASONIC OBSTACLE STOP\r\n * 7. INDIKATOR LED MATRIX\r\n * 8. BUZZER\r\n *\r\n * Tidak memakai NeoPixel.\r\n * Library: https://github.com/DFRobot/pxt-maqueen\r\n */\r\n\r\n// ====================================================\r\n// 1. KONFIGURASI\r\n// ====================================================\r\n\r\nlet modeAuto = true\r\nlet emergencyStop = false\r\nlet manualScan = false\r\nlet finishLocked = false\r\n\r\nlet baseSpeed = 100\r\nlet turnSpeed = 75\r\nlet obstacleLimit = 15\r\n\r\nlet leftSensor = 1\r\nlet rightSensor = 1\r\nlet lastDistance = -1\r\n\r\nlet finishArmed = false\r\nlet finishCount = 0\r\n\r\n// ====================================================\r\n// 2. MOTOR\r\n// ====================================================\r\n\r\nfunction stopRobot(): void {\r\n    maqueen.motorStop(maqueen.Motors.All)\r\n}\r\n\r\nfunction moveForward(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M1,\r\n        maqueen.Dir.CW,\r\n        speed\r\n    )\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M2,\r\n        maqueen.Dir.CW,\r\n        speed\r\n    )\r\n}\r\n\r\nfunction moveBackward(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M1,\r\n        maqueen.Dir.CCW,\r\n        speed\r\n    )\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M2,\r\n        maqueen.Dir.CCW,\r\n        speed\r\n    )\r\n}\r\n\r\nfunction moveLeft(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M1,\r\n        maqueen.Dir.CCW,\r\n        speed\r\n    )\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M2,\r\n        maqueen.Dir.CW,\r\n        speed\r\n    )\r\n}\r\n\r\nfunction moveRight(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M1,\r\n        maqueen.Dir.CW,\r\n        speed\r\n    )\r\n\r\n    maqueen.motorRun(\r\n        maqueen.Motors.M2,\r\n        maqueen.Dir.CCW,\r\n        speed\r\n    )\r\n}\r\n\r\n// ====================================================\r\n// 3. INDIKATOR\r\n// ====================================================\r\n\r\nfunction showAuto(): void {\r\n    basic.showString(\"A\")\r\n}\r\n\r\nfunction showManual(): void {\r\n    basic.showString(\"M\")\r\n}\r\n\r\nfunction showStop(): void {\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\nfunction showScan(): void {\r\n    basic.showIcon(IconNames.SmallDiamond)\r\n}\r\n\r\nfunction showObstacle(): void {\r\n    basic.showIcon(IconNames.Sad)\r\n}\r\n\r\nfunction showFinish(): void {\r\n    basic.showIcon(IconNames.Heart)\r\n}\r\n\r\n// ====================================================\r\n// 4. BUZZER\r\n// ====================================================\r\n\r\nfunction soundWarning(): void {\r\n    music.playTone(880, 150)\r\n}\r\n\r\nfunction soundFinish(): void {\r\n    music.playTone(1047, 150)\r\n    music.playTone(1319, 150)\r\n    music.playTone(1568, 250)\r\n}\r\n\r\n// ====================================================\r\n// 5. SENSOR IR\r\n//\r\n// Maqueen Lite:\r\n// 0 = HITAM\r\n// 1 = PUTIH\r\n// ====================================================\r\n\r\nfunction readLeft(): number {\r\n    return maqueen.readPatrol(\r\n        maqueen.Patrol.PatrolLeft\r\n    )\r\n}\r\n\r\nfunction readRight(): number {\r\n    return maqueen.readPatrol(\r\n        maqueen.Patrol.PatrolRight\r\n    )\r\n}\r\n\r\nfunction readSensors(): void {\r\n    leftSensor = readLeft()\r\n    rightSensor = readRight()\r\n}\r\n\r\n// ====================================================\r\n// 6. ULTRASONIC\r\n// ====================================================\r\n\r\nfunction readDistance(): number {\r\n    return maqueen.Ultrasonic()\r\n}\r\n\r\nfunction obstacleCheck(): boolean {\r\n    lastDistance = readDistance()\r\n\r\n    if (\r\n        lastDistance > 0 &&\r\n        lastDistance <= obstacleLimit\r\n    ) {\r\n        stopRobot()\r\n        showObstacle()\r\n        soundWarning()\r\n\r\n        // Menunggu halangan menjauh.\r\n        while (modeAuto && !emergencyStop) {\r\n            basic.pause(150)\r\n            lastDistance = readDistance()\r\n\r\n            if (\r\n                lastDistance <= 0 ||\r\n                lastDistance > obstacleLimit\r\n            ) {\r\n                break\r\n            }\r\n        }\r\n\r\n        stopRobot()\r\n        return true\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// ====================================================\r\n// 7. FINISH\r\n//\r\n// Penanda FINISH harus berupa garis hitam lebar.\r\n// Perhatian: persimpangan hitam lebar juga dapat\r\n// memicu kondisi ini.\r\n// ====================================================\r\n\r\nfunction checkFinish(): boolean {\r\n    readSensors()\r\n\r\n    // Robot harus terlebih dahulu meninggalkan\r\n    // pola kedua sensor hitam.\r\n    if (leftSensor == 0 || rightSensor == 0) {\r\n        finishArmed = true\r\n    }\r\n\r\n    if (\r\n        finishArmed &&\r\n        leftSensor == 0 &&\r\n        rightSensor == 0\r\n    ) {\r\n        finishCount += 1\r\n    } else {\r\n        finishCount = 0\r\n    }\r\n\r\n    // Sekitar 400 ms pada jeda loop 20 ms.\r\n    if (finishCount >= 20) {\r\n        finishLocked = true\r\n        stopRobot()\r\n        showFinish()\r\n        soundFinish()\r\n        return true\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// ====================================================\r\n// 8. AUTO LINE FOLLOWING\r\n// ====================================================\r\n\r\nfunction followLine(): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    readSensors()\r\n\r\n    if (checkFinish()) {\r\n        return\r\n    }\r\n\r\n    if (obstacleCheck()) {\r\n        return\r\n    }\r\n\r\n    // Kedua sensor putih:\r\n    // garis berada di antara sensor.\r\n    if (leftSensor == 1 && rightSensor == 1) {\r\n        moveForward(baseSpeed)\r\n    }\r\n\r\n    // Sensor kiri mendeteksi hitam.\r\n    else if (leftSensor == 0 && rightSensor == 1) {\r\n        moveLeft(turnSpeed)\r\n    }\r\n\r\n    // Sensor kanan mendeteksi hitam.\r\n    else if (leftSensor == 1 && rightSensor == 0) {\r\n        moveRight(turnSpeed)\r\n    }\r\n\r\n    // Kedua sensor hitam.\r\n    else {\r\n        if (finishArmed) {\r\n            moveForward(baseSpeed)\r\n        } else {\r\n            // Jangan langsung berhenti saat mulai\r\n            // di atas garis hitam.\r\n            stopRobot()\r\n        }\r\n    }\r\n}\r\n\r\n// ====================================================\r\n// 9. AUTO / MANUAL\r\n// ====================================================\r\n\r\nfunction activateAuto(): void {\r\n    emergencyStop = false\r\n    modeAuto = true\r\n    manualScan = false\r\n\r\n    stopRobot()\r\n    showAuto()\r\n}\r\n\r\nfunction activateManual(): void {\r\n    modeAuto = false\r\n    manualScan = false\r\n\r\n    stopRobot()\r\n    showManual()\r\n}\r\n\r\n// Tombol A: berganti mode.\r\ninput.onButtonPressed(Button.A, function () {\r\n    if (emergencyStop) {\r\n        activateAuto()\r\n    } else if (modeAuto) {\r\n        activateManual()\r\n    } else {\r\n        activateAuto()\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 10. SCAN MANUAL\r\n// Tekan B untuk memulai atau menghentikan scan.\r\n// ====================================================\r\n\r\nfunction scanForLine(): void {\r\n    if (emergencyStop || modeAuto || !manualScan) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    showScan()\r\n\r\n    for (let i = 0; i < 8; i++) {\r\n        if (emergencyStop || modeAuto || !manualScan) {\r\n            stopRobot()\r\n            return\r\n        }\r\n\r\n        readSensors()\r\n\r\n        if (leftSensor == 0 || rightSensor == 0) {\r\n            stopRobot()\r\n            manualScan = false\r\n            showManual()\r\n            return\r\n        }\r\n\r\n        moveLeft(turnSpeed)\r\n        basic.pause(100)\r\n        stopRobot()\r\n        basic.pause(50)\r\n    }\r\n\r\n    stopRobot()\r\n    showScan()\r\n}\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n    if (!modeAuto && !emergencyStop && !finishLocked) {\r\n        manualScan = !manualScan\r\n        stopRobot()\r\n\r\n        if (manualScan) {\r\n            showScan()\r\n        } else {\r\n            showManual()\r\n        }\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 11. EMERGENCY STOP\r\n// Tombol A+B.\r\n// ====================================================\r\n\r\ninput.onButtonPressed(Button.AB, function () {\r\n    emergencyStop = true\r\n    modeAuto = false\r\n    manualScan = false\r\n\r\n    stopRobot()\r\n    showStop()\r\n    soundWarning()\r\n})\r\n\r\n// ====================================================\r\n// 12. KONTROL MANUAL DENGAN GESTUR\r\n// ====================================================\r\n\r\ninput.onGesture(Gesture.LogoUp, function () {\r\n    if (!modeAuto && !manualScan && !emergencyStop && !finishLocked) {\r\n        moveForward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.LogoDown, function () {\r\n    if (!modeAuto && !manualScan && !emergencyStop && !finishLocked) {\r\n        moveBackward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltLeft, function () {\r\n    if (!modeAuto && !manualScan && !emergencyStop && !finishLocked) {\r\n        moveLeft(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltRight, function () {\r\n    if (!modeAuto && !manualScan && !emergencyStop && !finishLocked) {\r\n        moveRight(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.ScreenUp, function () {\r\n    if (!modeAuto && !emergencyStop) {\r\n        manualScan = false\r\n        stopRobot()\r\n        showStop()\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 13. INISIALISASI\r\n// ====================================================\r\n\r\nstopRobot()\r\nshowAuto()\r\n\r\n// ====================================================\r\n// 14. PROGRAM UTAMA\r\n// ====================================================\r\n\r\nbasic.forever(function () {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        basic.pause(50)\r\n    } else if (modeAuto) {\r\n        followLine()\r\n        basic.pause(20)\r\n    } else if (manualScan) {\r\n        scanForLine()\r\n        basic.pause(20)\r\n    } else {\r\n        basic.pause(20)\r\n    }\r\n}) ","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1793284837112,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"/*\r\n * MAQUEEN LITE STANDARD + MICRO:BIT\r\n * MAKECODE JAVASCRIPT / TYPESCRIPT\r\n *\r\n * FITUR:\r\n * 1. AUTO LINE TRACKING (2 SENSOR IR)\r\n * 2. MANUAL DENGAN GESTUR MICRO:BIT\r\n * 3. AUTO / MANUAL (TOMBOL A)\r\n * 4. EMERGENCY STOP (A+B)\r\n * 5. SCAN MANUAL (TOMBOL B)\r\n * 6. ULTRASONIC OBSTACLE AVOIDANCE\r\n * 7. INDIKATOR LED MATRIX\r\n * 8. BUZZER\r\n *\r\n * Tanpa NeoPixel, Bluetooth, dan GUI.\r\n * Library: https://github.com/DFRobot/pxt-maqueen\r\n */\r\n\r\n// ====================================================\r\n// 1. KONFIGURASI\r\n// ====================================================\r\n\r\nlet modeAuto = true\r\nlet emergencyStop = false\r\nlet manualScan = false\r\nlet finishLocked = false\r\n\r\nlet baseSpeed = 100\r\nlet turnSpeed = 75\r\nlet searchSpeed = 65\r\nlet obstacleLimit = 15\r\n\r\nlet leftSensor = 1\r\nlet rightSensor = 1\r\nlet lastDistance = -1\r\n\r\n// Arah terakhir: -1 = kiri, 1 = kanan\r\nlet lastTurn = 1\r\n\r\n// Status pencarian garis\r\nlet lostLine = false\r\nlet lineLostCount = 0\r\n\r\n// FINISH: garis hitam lebar\r\nlet finishArmed = false\r\nlet finishCount = 0\r\n\r\n// Penghindaran halangan\r\nlet avoidingObstacle = false\r\n\r\n// ====================================================\r\n// 2. MOTOR\r\n// ====================================================\r\n\r\nfunction stopRobot(): void {\r\n    maqueen.motorStop(maqueen.Motors.All)\r\n}\r\n\r\nfunction moveForward(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, speed)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, speed)\r\n}\r\n\r\nfunction moveBackward(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, speed)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, speed)\r\n}\r\n\r\nfunction moveLeft(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, speed)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, speed)\r\n}\r\n\r\nfunction moveRight(speed: number): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, speed)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, speed)\r\n}\r\n\r\n// Belok dengan kecepatan berbeda agar lebih halus.\r\n// Sesuaikan jika orientasi motor berbeda pada robotmu.\r\nfunction curveLeft(): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, baseSpeed * 0.45)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, baseSpeed)\r\n}\r\n\r\nfunction curveRight(): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, baseSpeed)\r\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, baseSpeed * 0.45)\r\n}\r\n\r\n// ====================================================\r\n// 3. INDIKATOR LED MATRIX\r\n// ====================================================\r\n\r\nfunction showAuto(): void {\r\n    basic.showString(\"A\")\r\n}\r\n\r\nfunction showManual(): void {\r\n    basic.showString(\"M\")\r\n}\r\n\r\nfunction showStop(): void {\r\n    basic.showIcon(IconNames.No)\r\n}\r\n\r\nfunction showScan(): void {\r\n    basic.showIcon(IconNames.SmallDiamond)\r\n}\r\n\r\nfunction showObstacle(): void {\r\n    basic.showIcon(IconNames.Sad)\r\n}\r\n\r\nfunction showFinish(): void {\r\n    basic.showIcon(IconNames.Heart)\r\n}\r\n\r\n// ====================================================\r\n// 4. BUZZER\r\n// ====================================================\r\n\r\nfunction soundWarning(): void {\r\n    music.playTone(880, 100)\r\n}\r\n\r\nfunction soundFinish(): void {\r\n    music.playTone(1047, 120)\r\n    music.playTone(1319, 120)\r\n    music.playTone(1568, 200)\r\n}\r\n\r\n// ====================================================\r\n// 5. SENSOR IR\r\n//\r\n// 0 = HITAM\r\n// 1 = PUTIH\r\n// ====================================================\r\n\r\nfunction readLeft(): number {\r\n    return maqueen.readPatrol(maqueen.Patrol.PatrolLeft)\r\n}\r\n\r\nfunction readRight(): number {\r\n    return maqueen.readPatrol(maqueen.Patrol.PatrolRight)\r\n}\r\n\r\nfunction readSensors(): void {\r\n    leftSensor = readLeft()\r\n    rightSensor = readRight()\r\n}\r\n\r\n// ====================================================\r\n// 6. ULTRASONIC\r\n// ====================================================\r\n\r\nfunction readDistance(): number {\r\n    return maqueen.Ultrasonic()\r\n}\r\n\r\nfunction obstacleDetected(): boolean {\r\n    lastDistance = readDistance()\r\n\r\n    return lastDistance > 0 &&\r\n        lastDistance <= obstacleLimit\r\n}\r\n\r\n// ====================================================\r\n// 7. FINISH\r\n//\r\n// Kedua sensor hitam terus-menerus selama beberapa\r\n// siklus dapat menunjukkan garis finish lebar.\r\n// Persimpangan juga dapat memicu kondisi ini.\r\n// ====================================================\r\n\r\nfunction checkFinish(): boolean {\r\n    readSensors()\r\n\r\n    // Arm hanya setelah robot meninggalkan pola 00.\r\n    if (leftSensor == 1 || rightSensor == 1) {\r\n        finishArmed = true\r\n    }\r\n\r\n    if (finishArmed &&\r\n        leftSensor == 0 &&\r\n        rightSensor == 0) {\r\n        finishCount += 1\r\n    } else {\r\n        finishCount = 0\r\n    }\r\n\r\n    if (finishCount >= 25) {\r\n        finishLocked = true\r\n        stopRobot()\r\n        showFinish()\r\n        soundFinish()\r\n        return true\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// ====================================================\r\n// 8. MENGHINDARI HALANGAN\r\n//\r\n// Robot mengurangi kecepatan, bermanuver, lalu\r\n// mencoba menemukan garis kembali.\r\n// ====================================================\r\n\r\nfunction avoidObstacle(): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    avoidingObstacle = true\r\n    showObstacle()\r\n    soundWarning()\r\n\r\n    // Perlambat dan bergerak sedikit menjauh.\r\n    moveBackward(65)\r\n    basic.pause(180)\r\n\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    // Manuver menghindar berdasarkan arah terakhir.\r\n    if (lastTurn == 1) {\r\n        moveRight(turnSpeed)\r\n    } else {\r\n        moveLeft(turnSpeed)\r\n    }\r\n\r\n    basic.pause(280)\r\n\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    // Maju melewati sisi halangan.\r\n    moveForward(75)\r\n    basic.pause(400)\r\n\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    // Putar kembali ke arah garis.\r\n    if (lastTurn == 1) {\r\n        moveLeft(turnSpeed)\r\n    } else {\r\n        moveRight(turnSpeed)\r\n    }\r\n\r\n    basic.pause(250)\r\n\r\n    // Tidak berhenti menunggu halangan menjauh.\r\n    // Masuk ke mode pencarian garis.\r\n    lostLine = true\r\n    lineLostCount = 0\r\n    avoidingObstacle = false\r\n}\r\n\r\n// ====================================================\r\n// 9. PENCARIAN GARIS SMOOTH\r\n//\r\n// Tidak melakukan pola stop-turn-stop berulang.\r\n// Robot berbelok terus sambil membaca kedua sensor.\r\n// ====================================================\r\n\r\nfunction searchLine(): void {\r\n    if (emergencyStop || finishLocked || !modeAuto) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    showScan()\r\n    readSensors()\r\n\r\n    // Garis ditemukan kembali.\r\n    if (leftSensor == 0 && rightSensor == 0) {\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveForward(baseSpeed)\r\n        return\r\n    }\r\n\r\n    if (leftSensor == 0 && rightSensor == 1) {\r\n        // Sesuai permintaan: belok kanan.\r\n        lastTurn = 1\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveRight(turnSpeed)\r\n        return\r\n    }\r\n\r\n    if (leftSensor == 1 && rightSensor == 0) {\r\n        // Sesuai permintaan: belok kiri.\r\n        lastTurn = -1\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveLeft(turnSpeed)\r\n        return\r\n    }\r\n\r\n    // 11 = kedua sensor putih.\r\n    // Tetap bergerak sambil mencari garis.\r\n    lineLostCount += 1\r\n\r\n    if (lastTurn == 1) {\r\n        moveRight(searchSpeed)\r\n    } else {\r\n        moveLeft(searchSpeed)\r\n    }\r\n\r\n    // Jika terlalu lama kehilangan garis, lakukan\r\n    // gerakan maju pendek lalu lanjutkan pencarian.\r\n    if (lineLostCount >= 40) {\r\n        moveForward(55)\r\n        basic.pause(100)\r\n        lineLostCount = 0\r\n    }\r\n}\r\n\r\n// ====================================================\r\n// 10. AUTO LINE TRACKING\r\n// ====================================================\r\n\r\nfunction followLine(): void {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    readSensors()\r\n\r\n    // Prioritas FINISH.\r\n    if (checkFinish()) {\r\n        return\r\n    }\r\n\r\n    // Prioritas penghindaran halangan.\r\n    if (obstacleDetected()) {\r\n        avoidObstacle()\r\n        return\r\n    }\r\n\r\n    // 00 = MAJU LURUS.\r\n    if (leftSensor == 0 && rightSensor == 0) {\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveForward(baseSpeed)\r\n    }\r\n\r\n    // 01 = BELOK KANAN.\r\n    else if (leftSensor == 0 && rightSensor == 1) {\r\n        lastTurn = 1\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveRight(turnSpeed)\r\n    }\r\n\r\n    // 10 = BELOK KIRI.\r\n    else if (leftSensor == 1 && rightSensor == 0) {\r\n        lastTurn = -1\r\n        lostLine = false\r\n        lineLostCount = 0\r\n        moveLeft(turnSpeed)\r\n    }\r\n\r\n    // 11 = CARI GARIS.\r\n    else {\r\n        lostLine = true\r\n        searchLine()\r\n    }\r\n}\r\n\r\n// ====================================================\r\n// 11. AUTO / MANUAL\r\n// ====================================================\r\n\r\nfunction activateAuto(): void {\r\n    if (finishLocked) {\r\n        return\r\n    }\r\n\r\n    emergencyStop = false\r\n    modeAuto = true\r\n    manualScan = false\r\n    lostLine = false\r\n    lineLostCount = 0\r\n\r\n    stopRobot()\r\n    showAuto()\r\n}\r\n\r\nfunction activateManual(): void {\r\n    if (finishLocked || emergencyStop) {\r\n        return\r\n    }\r\n\r\n    modeAuto = false\r\n    manualScan = false\r\n\r\n    stopRobot()\r\n    showManual()\r\n}\r\n\r\n// Tombol A untuk berganti mode.\r\ninput.onButtonPressed(Button.A, function () {\r\n    if (emergencyStop) {\r\n        emergencyStop = false\r\n        activateManual()\r\n    } else if (modeAuto) {\r\n        activateManual()\r\n    } else {\r\n        activateAuto()\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 12. SCAN MANUAL\r\n// Tombol B mengaktifkan / menonaktifkan scan.\r\n// ====================================================\r\n\r\nfunction scanForLine(): void {\r\n    if (emergencyStop || modeAuto || !manualScan) {\r\n        stopRobot()\r\n        return\r\n    }\r\n\r\n    readSensors()\r\n\r\n    // Garis ditemukan.\r\n    if (leftSensor == 0 || rightSensor == 0) {\r\n        stopRobot()\r\n        manualScan = false\r\n        showManual()\r\n        return\r\n    }\r\n\r\n    // Berputar terus tanpa stop setiap siklus.\r\n    if (lastTurn == 1) {\r\n        moveRight(searchSpeed)\r\n    } else {\r\n        moveLeft(searchSpeed)\r\n    }\r\n}\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n    if (!modeAuto && !emergencyStop && !finishLocked) {\r\n        manualScan = !manualScan\r\n\r\n        if (manualScan) {\r\n            showScan()\r\n        } else {\r\n            stopRobot()\r\n            showManual()\r\n        }\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 13. EMERGENCY STOP\r\n// Tombol A+B.\r\n// ====================================================\r\n\r\ninput.onButtonPressed(Button.AB, function () {\r\n    emergencyStop = true\r\n    modeAuto = false\r\n    manualScan = false\r\n\r\n    stopRobot()\r\n    showStop()\r\n    soundWarning()\r\n})\r\n\r\n// ====================================================\r\n// 14. KONTROL MANUAL DENGAN GESTUR\r\n// ====================================================\r\n\r\ninput.onGesture(Gesture.LogoUp, function () {\r\n    if (!modeAuto && !manualScan &&\r\n        !emergencyStop && !finishLocked) {\r\n        moveForward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.LogoDown, function () {\r\n    if (!modeAuto && !manualScan &&\r\n        !emergencyStop && !finishLocked) {\r\n        moveBackward(baseSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltLeft, function () {\r\n    if (!modeAuto && !manualScan &&\r\n        !emergencyStop && !finishLocked) {\r\n        lastTurn = -1\r\n        moveLeft(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.TiltRight, function () {\r\n    if (!modeAuto && !manualScan &&\r\n        !emergencyStop && !finishLocked) {\r\n        lastTurn = 1\r\n        moveRight(turnSpeed)\r\n    }\r\n})\r\n\r\ninput.onGesture(Gesture.ScreenUp, function () {\r\n    if (!emergencyStop && !finishLocked) {\r\n        manualScan = false\r\n        stopRobot()\r\n        showStop()\r\n    }\r\n})\r\n\r\n// ====================================================\r\n// 15. INISIALISASI\r\n// ====================================================\r\n\r\nstopRobot()\r\nshowAuto()\r\n\r\n// ====================================================\r\n// 16. PROGRAM UTAMA\r\n// ====================================================\r\n\r\nbasic.forever(function () {\r\n    if (emergencyStop || finishLocked) {\r\n        stopRobot()\r\n        basic.pause(50)\r\n    } else if (modeAuto) {\r\n        followLine()\r\n        basic.pause(10)\r\n    } else if (manualScan) {\r\n        scanForLine()\r\n        basic.pause(10)\r\n    } else {\r\n        basic.pause(20)\r\n    }\r\n})","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1793362868036,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"\r\n/*\r\n MAQUEEN LITE STANDARD + MICRO:BIT\r\n Microsoft MakeCode JavaScript / TypeScript\r\n\r\n AUTO       : line following 2 sensor IR\r\n MANUAL     : control by tilting micro:bit\r\n SCAN       : search for line\r\n OBSTACLE   : stop at 15 cm or less\r\n EMERGENCY  : press A+B to toggle emergency stop\r\n\r\n Extension:\r\n https://github.com/DFRobot/pxt-maqueen\r\n\r\n No NeoPixel.\r\n*/\r\n\r\nlet autoMode = true\r\nlet emergencyStop = false\r\nlet manualScan = false\r\nlet obstacleStop = false\r\n\r\nlet baseSpeed = 105\r\nlet turnSpeed = 70\r\nlet searchSpeed = 65\r\nlet obstacleLimit = 15\r\n\r\nlet leftSensor = 1\r\nlet rightSensor = 1\r\nlet distance = -1\r\nlet lastTurn = 0\r\n\r\n// --------------------------------------------------\r\n// MOTOR CONTROL\r\n// M1 = left motor\r\n// M2 = right motor\r\n// --------------------------------------------------\r\n\r\nfunction motorStopAll() {\r\n    maqueen.motorStop(maqueen.Motors.All)\r\n}\r\n\r\nfunction setOneMotor(motor: maqueen.Motors, speed: number) {\r\n    let power = Math.abs(speed)\r\n\r\n    if (power > 255) {\r\n        power = 255\r\n    }\r\n\r\n    if (speed == 0) {\r\n        maqueen.motorStop(motor)\r\n    } else if (motor == maqueen.Motors.M1) {\r\n        if (speed > 0) {\r\n            maqueen.motorRun(motor, maqueen.Dir.CW, power)\r\n        } else {\r\n            maqueen.motorRun(motor, maqueen.Dir.CCW, power)\r\n        }\r\n    } else {\r\n        if (speed > 0) {\r\n            maqueen.motorRun(motor, maqueen.Dir.CCW, power)\r\n        } else {\r\n            maqueen.motorRun(motor, maqueen.Dir.CW, power)\r\n        }\r\n    }\r\n}\r\n\r\nfunction driveMotors(leftSpeed: number, rightSpeed: number) {\r\n    setOneMotor(maqueen.Motors.M1, leftSpeed)\r\n    setOneMotor(maqueen.Motors.M2, rightSpeed)\r\n}\r\n\r\nfunction stopRobot() {\r\n    motorStopAll()\r\n}\r\n\r\n// --------------------------------------------------\r\n// INDICATOR LEDS\r\n// --------------------------------------------------\r\n\r\nfunction ledsOff() {\r\n    maqueen.writeLED(\r\n        maqueen.LED.LEDLeft,\r\n        maqueen.LEDswitch.turnOff\r\n    )\r\n    maqueen.writeLED(\r\n        maqueen.LED.LEDRight,\r\n        maqueen.LEDswitch.turnOff\r\n    )\r\n}\r\n\r\nfunction ledsOn() {\r\n    maqueen.writeLED(\r\n        maqueen.LED.LEDLeft,\r\n        maqueen.LEDswitch.turnOn\r\n    )\r\n    maqueen.writeLED(\r\n        maqueen.LED.LEDRight,\r\n        maqueen.LEDswitch.turnOn\r\n    )\r\n}\r\n\r\n// --------------------------------------------------\r\n// SOUND\r\n// --------------------------------------------------\r\n\r\nfunction beepWarning() {\r\n    music.playTone(880, 150)\r\n}\r\n\r\nfunction beepEmergency() {\r\n    music.playTone(440, 300)\r\n}\r\n\r\nfunction beepMode() {\r\n    music.playTone(660, 100)\r\n}\r\n\r\n// --------------------------------------------------\r\n// MODE INDICATOR\r\n// --------------------------------------------------\r\n\r\nfunction showMode() {\r\n    if (emergencyStop) {\r\n        basic.showString(\"X\")\r\n    } else if (obstacleStop) {\r\n        basic.showString(\"!\")\r\n    } else if (autoMode) {\r\n        basic.showString(\"A\")\r\n    } else {\r\n        basic.showString(\"M\")\r\n    }\r\n}\r\n\r\n// --------------------------------------------------\r\n// SENSOR READINGS\r\n// --------------------------------------------------\r\n\r\nfunction readLineSensors() {\r\n    leftSensor = maqueen.readPatrol(\r\n        maqueen.Patrol.PatrolLeft\r\n    )\r\n\r\n    rightSensor = maqueen.readPatrol(\r\n        maqueen.Patrol.PatrolRight\r\n    )\r\n}\r\n\r\nfunction readDistance() {\r\n    distance = maqueen.Ultrasonic()\r\n}\r\n\r\n// --------------------------------------------------\r\n// OBSTACLE DETECTION\r\n// --------------------------------------------------\r\n\r\nfunction checkObstacle(): boolean {\r\n    readDistance()\r\n\r\n    // 0 or negative values can mean invalid readings.\r\n    // Do not treat invalid readings as a detected obstacle.\r\n    if (distance > 0 && distance <= obstacleLimit) {\r\n        if (!obstacleStop) {\r\n            obstacleStop = true\r\n            stopRobot()\r\n            beepWarning()\r\n            showMode()\r\n        }\r\n\r\n        return true\r\n    }\r\n\r\n    if (obstacleStop) {\r\n        obstacleStop = false\r\n        showMode()\r\n    }\r\n\r\n    return false\r\n}\r\n\r\n// --------------------------------------------------\r\n// AUTO LINE FOLLOWING\r\n//\r\n// The standard Maqueen patrol sensors normally return:\r\n// 0 = black line\r\n// 1 = white surface\r\n//\r\n// The robot keeps moving and adjusts wheel speeds.\r\n// --------------------------------------------------\r\n\r\nfunction followLine() {\r\n    readLineSensors()\r\n\r\n    if (leftSensor == 0 && rightSensor == 0) {\r\n        // Both sensors see black.\r\n        // Continue forward.\r\n        driveMotors(baseSpeed, baseSpeed)\r\n    } else if (leftSensor == 0 && rightSensor == 1) {\r\n        // Line is detected on the left side.\r\n        // Correct toward the left.\r\n        lastTurn = -1\r\n        driveMotors(baseSpeed - turnSpeed, baseSpeed)\r\n    } else if (leftSensor == 1 && rightSensor == 0) {\r\n        // Line is detected on the right side.\r\n        // Correct toward the right.\r\n        lastTurn = 1\r\n        driveMotors(baseSpeed, baseSpeed - turnSpeed)\r\n    } else {\r\n        // Both sensors see white: line may be lost.\r\n        scanForLine()\r\n    }\r\n}\r\n\r\n// --------------------------------------------------\r\n// SCAN FOR LINE\r\n// --------------------------------------------------\r\n\r\nfunction scanForLine() {\r\n    basic.showString(\"?\")\r\n\r\n    if (lastTurn < 0) {\r\n        // Search left\r\n        driveMotors(-searchSpeed, searchSpeed)\r\n    } else if (lastTurn > 0) {\r\n        // Search right\r\n        driveMotors(searchSpeed, -searchSpeed)\r\n    } else {\r\n        // No previous turn direction: search left\r\n        driveMotors(-searchSpeed, searchSpeed)\r\n    }\r\n}\r\n\r\n// --------------------------------------------------\r\n// MANUAL CONTROL BY TILTING MICRO:BIT\r\n//\r\n// Tilt left/right to steer.\r\n// Tilt forward/backward to move.\r\n// Keep micro:bit level to stop.\r\n// --------------------------------------------------\r\n\r\nfunction manualControl() {\r\n    let pitch = input.rotation(Rotation.Pitch)\r\n    let roll = input.rotation(Rotation.Roll)\r\n\r\n    let forward = 0\r\n    let steering = 0\r\n\r\n    if (pitch < -15) {\r\n        forward = baseSpeed\r\n    } else if (pitch > 15) {\r\n        forward = -baseSpeed\r\n    }\r\n\r\n    if (roll < -15) {\r\n        steering = -turnSpeed\r\n    } else if (roll > 15) {\r\n        steering = turnSpeed\r\n    }\r\n\r\n    let leftSpeed = forward + steering\r\n    let rightSpeed = forward - steering\r\n\r\n    // Limit wheel speed to the allowed range.\r\n    if (leftSpeed > 255) {\r\n        leftSpeed = 255\r\n    }\r\n    if (leftSpeed < -255) {\r\n        leftSpeed = -255\r\n    }\r\n    if (rightSpeed > 255) {\r\n        rightSpeed = 255\r\n    }\r\n    if (rightSpeed < -255) {\r\n        rightSpeed = -255\r\n    }\r\n\r\n    driveMotors(leftSpeed, rightSpeed)\r\n}\r\n\r\n// --------------------------------------------------\r\n// BUTTON A: TOGGLE AUTO / MANUAL\r\n// --------------------------------------------------\r\n\r\ninput.onButtonPressed(Button.A, function () {\r\n    if (!emergencyStop) {\r\n        autoMode = !autoMode\r\n        manualScan = false\r\n        stopRobot()\r\n        beepMode()\r\n        showMode()\r\n    }\r\n})\r\n\r\n// --------------------------------------------------\r\n// BUTTON B: MANUAL SCAN MODE\r\n// Press B to toggle scan mode while in MANUAL.\r\n// --------------------------------------------------\r\n\r\ninput.onButtonPressed(Button.B, function () {\r\n    if (!emergencyStop && !autoMode) {\r\n        manualScan = !manualScan\r\n        stopRobot()\r\n\r\n        if (manualScan) {\r\n            basic.showString(\"?\")\r\n        } else {\r\n            showMode()\r\n        }\r\n    }\r\n})\r\n\r\n// --------------------------------------------------\r\n// BUTTON A+B: EMERGENCY STOP ON/OFF\r\n// Press A+B again to release the emergency stop.\r\n// --------------------------------------------------\r\n\r\ninput.onButtonPressed(Button.AB, function () {\r\n    emergencyStop = !emergencyStop\r\n    manualScan = false\r\n    obstacleStop = false\r\n    stopRobot()\r\n\r\n    if (emergencyStop) {\r\n        ledsOn()\r\n        beepEmergency()\r\n        basic.showString(\"X\")\r\n    } else {\r\n        ledsOff()\r\n        showMode()\r\n    }\r\n})\r\n\r\n// --------------------------------------------------\r\n// STARTUP\r\n// --------------------------------------------------\r\n\r\nbasic.showString(\"MQ\")\r\nbasic.pause(300)\r\nshowMode()\r\n\r\n// --------------------------------------------------\r\n// MAIN LOOP\r\n// --------------------------------------------------\r\n\r\nbasic.forever(function () {\r\n    if (emergencyStop) {\r\n        stopRobot()\r\n        basic.pause(50)\r\n    } else if (checkObstacle()) {\r\n        stopRobot()\r\n        basic.pause(100)\r\n    } else if (autoMode) {\r\n        manualScan = false\r\n        followLine()\r\n        basic.pause(10)\r\n    } else if (manualScan) {\r\n        scanForLine()\r\n        basic.pause(20)\r\n    } else {\r\n        manualControl()\r\n        basic.pause(20)\r\n    }\r\n})\r\n","README.md":"","pxt.json":"{\n    \"name\": \"projek\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1793362868129}